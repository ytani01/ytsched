{
  "description": "ytsched repository hooks imported from Claude Code.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/check-md-commit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking Markdown commit workflow"
          }
        ]
      }
    ]
  }
}
